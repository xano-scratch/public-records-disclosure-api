{
  "name": "public-records-disclosure-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run xano:routes && vite",
    "build": "npm run xano:routes && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run xano:routes && tsc --noEmit",
    "xano:routes": "xanots routes ./xano/index.ts --emit xano/routes.gen.ts",
    "xano:export": "npm run xano:routes && tsc --noEmit && xanots export ./xano/index.ts --out workspace.json",
    "xano:deploy": "npm run build && xanots deploy ./xano/index.ts --static ./frontend/dist",
    "xano:deploy:local-engine": "npm run xano:routes && tsc --noEmit && xanots deploy ./xano/index.ts --local-engine --keep-data",
    "xano:deploy:frontend": "npm run build && xanots publish ./frontend/dist",
    "xano:check": "xanots routes ./xano/index.ts --emit xano/routes.gen.ts --strict && tsc --noEmit && xanots export ./xano/index.ts --check --strict",
    "xano:test": "xanots test run-all"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "*",
    "@xanots/sdk": "0.0.52",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.475.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.1.5",
    "tsx": "4.19.2",
    "tw-animate-css": "^1.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=20.19"
  },
  "xanots": {
    "@xanots/sdk": {
      "localEngine": "v0.1.15"
    }
  }
}
